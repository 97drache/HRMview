# Gemini API — 데스크톱 HRM(6-1·6-2) 전용
#
# 설정 방법 (처음 한 번):
#   1. 이 파일(.env.example)을 복사해 같은 폴더에 ".env" 로 저장
#      (예: 메모장에서 "다른 이름으로 저장" → 파일 이름: .env)
#   2. 아래 GEMINI_API_KEY= 뒤에 발급한 키를 붙여넣고 저장
#   3. HRM-Desktop.exe 를 다시 실행
#
# 주의: 실제 키는 .env 에만 넣으세요. .env.example 은 Git에 올라가는 템플릿입니다.
# 키 발급: https://aistudio.google.com/apikey
# 자세한 안내: docs/gemini-setup.md

GEMINI_API_KEY=
# gemini-2.0-flash 무료 한도 0 오류(429) 시 아래 lite 모델 사용 (기본값과 동일)
GEMINI_MODEL=gemini-2.0-flash-lite

# 7. 인사법령 — 국가법령정보 공동활용 OPEN API (https://open.law.go.kr 신청 OC)
# 실제 OC는 .env 에만 입력 (이 템플릿·Git·mcp.json 에 넣지 마세요)
LAW_GO_KR_OC=
LAW_GO_KR_TYPE=JSON

# 7-4 GIST 사내 규정 폴더 (기본: data/gist-regulations · PDF·TXT·MD 지원)
# GIST_REGULATIONS_DIR=

# 모바일(인원현황) 스냅샷 — 기본: 하루 1회 저장 후 git push (끄려면 0)
# HRM_HEADCOUNT_AUTO_PUBLISH=0
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
